# cvtool 설정 예시. 복사해서 .env 로 만들고 값을 채우세요. (.env 는 커밋 금지)
# cp .env.example .env

# --- 저장소 비밀번호 (필수, 반드시 변경) ---
CVTOOL_PG_PASSWORD=change-me

# --- 로컬 LLM / TEI (기본값이 요청서와 동일하면 생략 가능) ---
# CVTOOL_LLM_BASE_URL=http://localhost:8000/v1
# CVTOOL_LLM_MODEL=thinkingcap
# CVTOOL_LLM_API_KEY=EMPTY
# CVTOOL_EMBED_URL=http://localhost:8081
# CVTOOL_RERANK_URL=http://localhost:8082

# --- 저장소 (기존 5432/6333 금지) ---
# CVTOOL_PG_HOST=127.0.0.1
# CVTOOL_PG_PORT=5433
# CVTOOL_PG_USER=cvtool
# CVTOOL_PG_DB=cvtool_db
# CVTOOL_QDRANT_URL=http://127.0.0.1:6335

# --- 개인정보 보관 기간(개월) / 시간대 ---
# CVTOOL_RETENTION_MONTHS=6
# CVTOOL_TZ=Asia/Seoul
