# cvtool 설정 예시. 복사해서 .env 로 만들고 값을 채우세요. (.env 는 커밋 금지)
# cp .env.example .env

# --- 저장소 비밀번호 (필수, 반드시 변경) ---
CVTOOL_PG_PASSWORD=change-me

# --- 최초 관리자 계정 (필수) ---
# 계정이 하나도 없을 때 이 값으로 관리자를 만듭니다.
# 이후 계정은 웹의 '계정' 화면에서 추가합니다.
CVTOOL_ADMIN_PASSWORD=change-me-too
# CVTOOL_ADMIN_ID=admin
# 예전 설정(CVTOOL_WEB_PASSWORD)만 있어도 그 값으로 admin 계정이 만들어집니다.
# CVTOOL_WEB_PORT=8600
# CVTOOL_WEB_HOST=0.0.0.0
# 지원자 DB·학회 목록이 저장되는 위치 (기본: ~/.cvtool)
# CVTOOL_DATA_DIR=/home/사용자/.cvtool

# --- LLM 출력 상한 (기본 32768) ---
# 이 값은 **한 번에 만들 출력의 상한**이지 목표치가 아닙니다. 모델은 답이
# 끝나면 멈추므로 크게 잡아도 평소 속도에는 영향이 없습니다. 반대로 작으면
# 논문 많은 사람이나 과제 많은 매칭에서 JSON 이 중간에 잘려 통째로 날아갑니다.
# (프롬프트 토큰 + 이 값 <= 모델 컨텍스트 여야 합니다.)
# CVTOOL_LLM_MAX_TOKENS=32768

# --- 2단계 추출 (기본 켜짐) ---
# 1단계: 스키마 없이 자유롭게 읽고 정리 -> 2단계: JSON 강제.
# guided_json 은 첫 토큰부터 문법을 강제해 추론 모델이 생각할 자리를 없앤다.
# 0 으로 끄면 곧바로 구조화 추출한다. 품질 비교용으로 켜고 꺼보세요.
# CVTOOL_TWO_STAGE=1

# --- 한 번에 추출 (기본 꺼짐) ---
# 인적사항·학력·연구·경력을 한 호출로 받는다. LLM 호출이 5회 -> 2회가 되고,
# 무엇보다 CV 전문을 네 번이 아니라 한 번만 보내서 분석이 크게 빨라진다.
#
# 기본을 끔으로 둔 이유: 스키마가 커지면 뒤쪽 항목(연구분야_키워드, 석박통합)에
# 주의가 덜 갈 수 있다. 같은 CV 를 양쪽으로 돌려 결과를 비교한 뒤 켜세요.
# 답이 잘리거나 일부가 빠지면 저절로 섹션별로 나눠 다시 받는다.
# CVTOOL_EXTRACT_ONESHOT=0

# --- CV 본문 최대 길이(문자). 넘으면 잘리고 검토_필요 로 표시된다 ---
# `cvtool health` 가 모델의 max_model_len 을 알려주니 그에 맞춰 잡으세요.
# CVTOOL_MAX_INPUT_CHARS=24000

# --- 로컬 LLM / TEI (기본값이 요청서와 동일하면 생략 가능) ---
# CVTOOL_LLM_BASE_URL=http://localhost:8000/v1
# CVTOOL_LLM_MODEL=thinkingcap
# CVTOOL_LLM_API_KEY=EMPTY
# CVTOOL_EMBED_URL=http://localhost:8081
# CVTOOL_RERANK_URL=http://localhost:8082

# --- 저장소 (기존 5432/6333 금지) ---
# CVTOOL_PG_HOST=127.0.0.1
# CVTOOL_PG_PORT=5433
# CVTOOL_PG_USER=cvtool
# CVTOOL_PG_DB=cvtool_db
# CVTOOL_QDRANT_URL=http://127.0.0.1:6335

# --- 개인정보 보관 기간(개월). 0 = 무제한(기본, 자동 삭제 안 함) ---
# CVTOOL_RETENTION_MONTHS=0
# CVTOOL_TZ=Asia/Seoul

# --- CV 원문 텍스트 보관 (기본 꺼짐) ---
# 끄면 추출 후 원문이 남지 않아 개인정보가 최소화되지만,
# 프롬프트를 개선해도 재분석하려면 CV 를 다시 업로드해야 합니다.
# 켜면 웹에서 '다시 분석' 버튼으로 재추출할 수 있지만 CV 전문이 DB 에 남습니다.
# CVTOOL_STORE_CV_TEXT=0

# --- 사내 메일 API (메일 탭) ---
# ⚠️ 실제 발송은 MAIL_DRY_RUN=0 일 때만 합니다. 기본은 1(보내지 않고 기록만).
#    설정을 다 맞춘 뒤에 0 으로 바꾸세요.
MAIL_DRY_RUN=1
# MAIL_API_URL=https://mail.사내도메인/api/...   (userId 는 코드가 URL 에 직접 붙입니다)
# MAIL_API_TOKEN=
# MAIL_API_SYSTEM_ID=
# MAIL_API_USER_ID=
# MAIL_SENDER=recruit@회사.com
# MAIL_API_TIMEOUT=30

# --- 연구 과제 매칭 (과제 탭) ---
# 회사 연구 과제를 정리해둔 JSON 파일 경로.
# 상대경로는 **CV-parser 폴더 기준**입니다. `cd ../과제정보` 로 가는 곳이면:
#   CVTOOL_PROJECTS_JSON=../과제정보/과제.json
# 절대경로도 됩니다 (헷갈리면 이쪽이 확실):
#   CVTOOL_PROJECTS_JSON=/home/사용자/과제정보/과제.json
# CVTOOL_PROJECTS_JSON=
# 한 번에 몇 개 과제를 물어볼지. **0 = 전부 한 번에** (기본, 권장)
#
# 나눠 물으면 모델이 묶음 안에서만 상대 비교를 해서 묶음 경계를 넘는 점수가
# 서로 안 맞습니다. 한 번에 다 보여줘야 줄을 제대로 세웁니다.
# 답이 잘리면 자동으로 반씩 쪼개 다시 물으므로 결과를 잃지 않습니다.
# CVTOOL_MATCH_BATCH=0
# 상세 화면에 펼쳐 보일 상위 과제 수 (나머지는 접어 둡니다)
# CVTOOL_MATCH_SHOW=3
# CV 분석이 끝나면 매칭까지 자동으로 돌릴지 (기본 켜짐)
# CVTOOL_MATCH_AUTO=1
# 다듬은 과제 파일 위치 (비우면 데이터 폴더에 만듭니다)
# CVTOOL_PROJECTS_CURATED=
