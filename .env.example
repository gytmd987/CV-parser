# cvtool 설정 예시. 복사해서 .env 로 만들고 값을 채우세요. (.env 는 커밋 금지)
# cp .env.example .env

# --- 저장소 비밀번호 (필수, 반드시 변경) ---
CVTOOL_PG_PASSWORD=change-me

# --- 웹 로그인 비밀번호 (필수). 채용 담당자에게만 공유하세요 ---
CVTOOL_WEB_PASSWORD=change-me-too
# CVTOOL_WEB_PORT=8600
# CVTOOL_WEB_HOST=0.0.0.0
# 지원자 DB·학회 목록이 저장되는 위치 (기본: ~/.cvtool)
# CVTOOL_DATA_DIR=/home/사용자/.cvtool

# --- LLM 출력 상한. 잘림이 나면 늘리세요 ---
# CVTOOL_LLM_MAX_TOKENS=4096

# --- 2단계 추출 (기본 켜짐) ---
# 1단계: 스키마 없이 자유롭게 읽고 정리 -> 2단계: JSON 강제.
# guided_json 은 첫 토큰부터 문법을 강제해 추론 모델이 생각할 자리를 없앤다.
# 0 으로 끄면 곧바로 구조화 추출한다. 품질 비교용으로 켜고 꺼보세요.
# CVTOOL_TWO_STAGE=1

# --- CV 본문 최대 길이(문자). 넘으면 잘리고 검토_필요 로 표시된다 ---
# `cvtool health` 가 모델의 max_model_len 을 알려주니 그에 맞춰 잡으세요.
# CVTOOL_MAX_INPUT_CHARS=24000

# --- 로컬 LLM / TEI (기본값이 요청서와 동일하면 생략 가능) ---
# CVTOOL_LLM_BASE_URL=http://localhost:8000/v1
# CVTOOL_LLM_MODEL=thinkingcap
# CVTOOL_LLM_API_KEY=EMPTY
# CVTOOL_EMBED_URL=http://localhost:8081
# CVTOOL_RERANK_URL=http://localhost:8082

# --- 저장소 (기존 5432/6333 금지) ---
# CVTOOL_PG_HOST=127.0.0.1
# CVTOOL_PG_PORT=5433
# CVTOOL_PG_USER=cvtool
# CVTOOL_PG_DB=cvtool_db
# CVTOOL_QDRANT_URL=http://127.0.0.1:6335

# --- 개인정보 보관 기간(개월) / 시간대 ---
# CVTOOL_RETENTION_MONTHS=6
# CVTOOL_TZ=Asia/Seoul
